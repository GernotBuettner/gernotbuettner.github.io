{% macro projectComponent( project ) %}
	<div class="project">
		{% if project.link %}
			<a class="project__link" href="{{ project.link }}" target="_blank" rel="noopener noreferrer">
		{% endif %}
			<h4 class="project__headline">{{ project.name | safe }}</h4>
		{% if project.link %}
			</a>
		{% endif %}
		<div class="project__text ugc">{{ project.description | safe }}</div>
		{% if project.techstack %}
			<p class="project__techstack">→ {{ project.techstack }}</p>
		{% endif %}
	</div>
{% endmacro %}